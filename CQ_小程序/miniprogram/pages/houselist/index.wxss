page {
  height: 100%;
  background: #f5f6f8;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.content {
  padding: 6rpx 20rpx 28rpx;
}

.fixed-panel {
  flex-shrink: 0;
  padding-bottom: 10rpx;
}

.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-content {
  padding-top: 0;
}

.city-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  margin-right: 4rpx;
}

.search-box {
  height: 80rpx;
  border: 3rpx solid #1f7dff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx 0 18rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.search-left {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 0 18rpx;
}

.search-input {
  flex: 1;
  color: #32353c;
  font-size: 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-weight: 500;
}

.search-placeholder {
  color: #9ea4af;
  font-size: 32rpx;
  font-weight: 500;
}

.search-btn {
  width: 138rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #1974ff;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.filter-row {
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.filter-row picker {
  width: 33.33%;
}

.filter-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-text {
  color: #7f838d;
  font-size: 30rpx;
  font-weight: 500;
}

.filter-arrow {
  margin-left: 6rpx;
  color: #c0c3ca;
  font-size: 18rpx;
}

.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.left-col,
.right-col {
  flex: 1;
  min-width: 0;
}

.house-card {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  border: 1rpx solid #efeff2;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.house-image-wrap {
  position: relative;
  overflow: hidden;
  width: 100%;
  max-width: 100%;
  height: 258rpx;
}

.house-image {
  width: 100%;
  max-width: 100%;
  height: 258rpx;
  display: block;
}

.auction-mode-badge {
  position: absolute;
  right: 0;
  top: 0;
  width: 58rpx;
  height: 31rpx;
  z-index: 3;
}

.community-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 44rpx;
  padding: 0 14rpx;
  background: rgba(95, 101, 112, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.community-text {
  display: block;
  width: 100%;
  max-width: 100%;
  color: #fff;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.house-content {
  padding: 12rpx 14rpx 10rpx;
}

.house-title {
  color: #1f232d;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 38rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  min-height: 72rpx;
}

.house-meta-line {
  display: block;
  margin-top: 20rpx;
  color: #636b78;
  font-size: 23rpx;
  line-height: 20rpx;
}

.price-line {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  column-gap: 18rpx;
  line-height: 20rpx;
}

.price-item {
  color: #636b78;
  font-size: 20rpx;
  line-height: 24rpx;
}

.price-start {
  color: #f04438;
  font-weight: 700;
}

.price-market {
  color: #1f232d;
  font-weight: 700;
}

.status-line {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  column-gap: 10rpx;
  line-height: 24rpx;
}

.status-label {
  flex-shrink: 0;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 28rpx;
  height: 28rpx;
}

.status-upcoming {
  color: #b54708;
  background: #fffaeb;
}

.status-running {
  color: #175cd3;
  background: #eff8ff;
}

.status-finished {
  color: #344054;
  background: #f2f4f7;
}

.status-unknown {
  color: #6941c6;
  background: #f9f5ff;
}

.time-text {
  color: #8a919d;
  font-size: 20rpx;
  line-height: 24rpx;
  flex: 1;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.load-more-tip {
  text-align: center;
  color: #9aa0ab;
  font-size: 24rpx;
  padding: 14rpx 0 30rpx;
}
