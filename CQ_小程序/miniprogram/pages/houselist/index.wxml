<view class="page">
  <view class="content fixed-panel">
    <view class="search-box">
      <view class="search-left">
        <image class="city-icon" src="/assets/icons/city-icon.png" mode="aspectFit" />
        <input
          class="search-input"
          type="text"
          placeholder="输入小区或地址"
          placeholder-class="search-placeholder"
          confirm-type="search"
          maxlength="50"
          cursor-spacing="20"
          value="{{keyword}}"
          bindinput="onKeywordInput"
          bindconfirm="onSearchConfirm"
        />
      </view>
      <view class="search-btn" bindtap="onSearchTap">搜索</view>
    </view>

    <view class="filter-row">
      <picker mode="selector" range="{{filterOptions.area}}" value="{{filterIndex.area}}" bindchange="onAreaFilterChange">
        <view class="filter-item">
          <text class="filter-text">{{filterOptions.area[filterIndex.area]}}</text>
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
      <picker mode="selector" range="{{filterOptions.layout}}" value="{{filterIndex.layout}}" bindchange="onLayoutFilterChange">
        <view class="filter-item">
          <text class="filter-text">{{filterOptions.layout[filterIndex.layout]}}</text>
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
      <picker mode="selector" range="{{filterOptions.price}}" value="{{filterIndex.price}}" bindchange="onPriceFilterChange">
        <view class="filter-item">
          <text class="filter-text">{{filterOptions.price[filterIndex.price]}}</text>
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <scroll-view class="list-scroll" scroll-y lower-threshold="120" bindscrolltolower="onLoadMore">
    <view class="content list-content">
      <view class="waterfall">
        <view class="left-col">
          <block wx:for="{{feedLeft}}" wx:key="id">
            <view class="house-card" data-id="{{item.id}}" bindtap="onHouseTap">
              <view class="house-image-wrap">
                <image class="house-image" src="{{item.image}}" mode="aspectFill"></image>
                <image class="auction-mode-badge" wx:if="{{item.auctionModeBadge}}" src="{{item.auctionModeBadge}}" mode="aspectFit" />
                <view class="community-overlay">
                  <text class="community-text">{{item.communityNameText}}</text>
                </view>
              </view>
              <view class="house-content">
                <text class="house-title">{{item.position}}</text>
                <view class="house-meta-line">
                  <text>{{item.areaText}}</text>
                  <text wx:if="{{item.layoutText}}"> · {{item.layoutText}}</text>
                  <text wx:if="{{item.orientationText}}"> · {{item.orientationText}}</text>
                </view>
                <view class="price-line">
                  <text class="price-item">
                    起拍价：<text class="price-start">{{item.startingPriceText}}</text>
                  </text>
                  <text class="price-item">
                    市场价：<text class="price-market">{{item.marketPriceText}}</text>
                  </text>
                </view>
                <view class="status-line">
                  <text class="status-label status-{{item.auctionStatusType}}">{{item.auctionStatusText}}</text>
                  <text class="time-text">{{item.auctionTimeText}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
        <view class="right-col">
          <block wx:for="{{feedRight}}" wx:key="id">
            <view class="house-card" data-id="{{item.id}}" bindtap="onHouseTap">
              <view class="house-image-wrap">
                <image class="house-image" src="{{item.image}}" mode="aspectFill"></image>
                <image class="auction-mode-badge" wx:if="{{item.auctionModeBadge}}" src="{{item.auctionModeBadge}}" mode="aspectFit" />
                <view class="community-overlay">
                  <text class="community-text">{{item.communityNameText}}</text>
                </view>
              </view>
              <view class="house-content">
                <text class="house-title">{{item.position}}</text>
                <view class="house-meta-line">
                  <text>{{item.areaText}}</text>
                  <text wx:if="{{item.layoutText}}"> · {{item.layoutText}}</text>
                  <text wx:if="{{item.orientationText}}"> · {{item.orientationText}}</text>
                </view>
                <view class="price-line">
                  <text class="price-item">
                    起拍价：<text class="price-start">{{item.startingPriceText}}</text>
                  </text>
                  <text class="price-item">
                    市场价：<text class="price-market">{{item.marketPriceText}}</text>
                  </text>
                </view>
                <view class="status-line">
                  <text class="status-label status-{{item.auctionStatusType}}">{{item.auctionStatusText}}</text>
                  <text class="time-text">{{item.auctionTimeText}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>
      <view class="load-more-tip" wx:if="{{!hasMore}}">没有更多了</view>
    </view>
  </scroll-view>
</view>
