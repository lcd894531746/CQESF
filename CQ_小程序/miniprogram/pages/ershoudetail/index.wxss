.detail-page { min-height: 100vh; background: #f5f6f8; }
.detail-body { padding-bottom: 170rpx; }
.banner-wrap { position: relative; }
.banner { width: 100%; height: 480rpx; background: #e9ebef; }
.banner-image { width: 100%; height: 100%; }
.empty-resource {
  box-sizing: border-box;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.empty-resource-icon {
  position: relative;
  width: 92rpx;
  height: 82rpx;
}
.empty-resource-roof {
  position: absolute;
  left: 13rpx;
  top: 0;
  width: 60rpx;
  height: 60rpx;
  border-left: 10rpx solid #cbd5e1;
  border-top: 10rpx solid #cbd5e1;
  transform: rotate(45deg);
  border-radius: 5rpx;
}
.empty-resource-house {
  position: absolute;
  left: 12rpx;
  bottom: 0;
  width: 68rpx;
  height: 50rpx;
  border: 10rpx solid #cbd5e1;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
}
.empty-resource-door {
  position: absolute;
  left: 22rpx;
  bottom: -10rpx;
  width: 16rpx;
  height: 26rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #cbd5e1;
}
.empty-resource-text {
  color: #94a3b8;
  font-size: 26rpx;
  font-weight: 700;
}
.banner-index {
  position: absolute; right: 20rpx; bottom: 20rpx; min-width: 84rpx; height: 40rpx; padding: 0 12rpx;
  border-radius: 20rpx; background: rgba(0,0,0,.42); color: #fff; font-size: 22rpx; line-height: 40rpx; text-align: center;
}
.preview-btn {
  position: absolute; left: 20rpx; bottom: 20rpx; min-width: 120rpx; height: 40rpx; padding: 0 14rpx;
  border-radius: 20rpx; background: rgba(0,0,0,.42); color: #fff; font-size: 22rpx; line-height: 40rpx; text-align: center;
}
.detail-content { background: #fff; margin-top: 14rpx; padding: 24rpx; }
.title-row { color: #1f232d; font-size: 34rpx; font-weight: 700; line-height: 46rpx; }
.position-line { display: flex; align-items: flex-start; column-gap: 12rpx; }
.position-row { margin-top: 8rpx; color: #6b7280; font-size: 24rpx; line-height: 34rpx; flex: 1; }
.location-btn {
  margin-top: 8rpx; flex-shrink: 0; height: 44rpx; line-height: 44rpx; border-radius: 22rpx; padding: 0 16rpx;
  background: #eef4ff; color: #1e5fe0; font-size: 22rpx; font-weight: 600;
}
.price-row { margin-top: 16rpx; font-size: 30rpx; line-height: 42rpx; color: #646b78; }
.price-start { color: #f04438; font-weight: 700; }
.price-gap { margin-left: 30rpx; color: #646b78; }
.price-market { color: #1f232d; font-weight: 700; }
.loan-row {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.loan-item {
  color: #64748b;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}
.loan-monthly {
  color: #175cd3;
  font-size: 30rpx;
  font-weight: 900;
}
.meta-row { margin-top: 14rpx; color: #4f5663; font-size: 28rpx; line-height: 40rpx; }
.meta-gap { margin: 0 12rpx; color: #b2b7c1; }
.meta-orientation { margin-left: 12rpx; }
.tag-card { margin-top: 22rpx; }
.tag-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.detail-tag {
  display: inline-flex;
  align-items: center;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 52rpx;
}
.detail-tag-metro {
  background: #e8f2ff;
  color: #1e5fe0;
}
.detail-tag-feature {
  background: #eef8ef;
  color: #237b45;
}
.info-card { margin-top: 22rpx; padding: 20rpx; border-radius: 16rpx; background: #f8fafc; }
.card-title { color: #1f2937; font-size: 26rpx; font-weight: 600; margin-bottom: 14rpx; }
.info-grid { display: flex; flex-wrap: wrap; margin: 0 -10rpx; }
.info-item { width: 50%; box-sizing: border-box; padding: 10rpx; }
.info-label { display: block; color: #94a3b8; font-size: 22rpx; line-height: 32rpx; }
.info-value { display: block; margin-top: 4rpx; color: #111827; font-size: 24rpx; line-height: 34rpx; word-break: break-all; }
.content-bottom-space { height: 20rpx; }
.fixed-contact-bar {
  position: fixed; left: 0; right: 0; bottom: 0; height: 128rpx; background: #fff; border-top: 1rpx solid #eceff4;
  padding: 14rpx 24rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box;
}
.contact-left { display: flex; align-items: center; min-width: 0; }
.contact-avatar { width: 72rpx; height: 72rpx; border-radius: 36rpx; background: #eff2f7; }
.default-avatar { display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(180deg,#f3f5f8 0%,#e6eaf0 100%); overflow: hidden; }
.avatar-head { width: 24rpx; height: 24rpx; border-radius: 12rpx; background: #c2cad5; }
.avatar-body { margin-top: 4rpx; width: 34rpx; height: 16rpx; border-radius: 12rpx 12rpx 6rpx 6rpx; background: #c2cad5; }
.contact-info { margin-left: 14rpx; display: flex; flex-direction: column; min-width: 0; }
.contact-name { color: #1f232d; font-size: 28rpx; font-weight: 600; line-height: 36rpx; }
.contact-phone { margin-top: 2rpx; color: #8b92a0; font-size: 22rpx; line-height: 30rpx; }
.call-btn { width: 188rpx; height: 76rpx; line-height: 76rpx; border-radius: 38rpx; background: #1974ff; color: #fff; font-size: 30rpx; font-weight: 700; padding: 0; margin: 0; border: none; box-shadow: none; }
.call-btn::after { border: none; }
