<view class="detail-page">
  <view class="detail-body">
    <view class="banner-wrap">
      <swiper wx:if="{{house.hasImages}}" class="banner" indicator-dots duration="300" touchable current="{{currentImageIndex}}" bindchange="onSwiperChange">
        <swiper-item wx:for="{{house.images}}" wx:key="*this">
          <image class="banner-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>
      <view wx:else class="banner empty-resource">
        <view class="empty-resource-icon">
          <view class="empty-resource-roof"></view>
          <view class="empty-resource-house">
            <view class="empty-resource-door"></view>
          </view>
        </view>
        <text class="empty-resource-text">暂无图片</text>
      </view>
      <view wx:if="{{house.hasImages}}" class="banner-index">{{currentImageIndex + 1}} / {{house.images.length || 1}}</view>
      <view wx:if="{{house.hasImages}}" class="preview-btn" bindtap="onPreviewCurrentImage">预览大图</view>
    </view>

    <view class="detail-content">
      <view class="title-row">{{house.title}}</view>
      <view class="position-line">
        <view class="position-row">{{house.position}}</view>
        <view wx:if="{{house.longitude !== null && house.latitude !== null}}" class="location-btn" bindtap="onGoLocationTap">查看位置</view>
      </view>
      <view class="price-row">
        <text>总价：</text>
        <text class="price-start">{{house.totalPriceText}}</text>
        <text class="price-gap">单价：</text>
        <text class="price-market">{{house.unitPriceText}}</text>
      </view>
      <view class="loan-row">
        <text class="loan-item">首付 {{house.downPaymentText}}</text>
        <text class="loan-item loan-monthly">月供 {{house.monthlyPaymentText}}</text>
      </view>
      <view class="meta-row">
        <text>{{house.layoutText || '暂无户型'}}</text>
        <text class="meta-gap">|</text>
        <text>{{house.areaText}}</text>
        <text class="meta-orientation" wx:if="{{house.orientationText}}">| {{house.orientationText}}</text>
      </view>

      <view class="tag-card" wx:if="{{house.metroTags.length}}">
        <view class="card-title">地铁</view>
        <view class="tag-list">
          <text class="detail-tag detail-tag-metro" wx:for="{{house.metroTags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="tag-card" wx:if="{{house.featureTags.length}}">
        <view class="card-title">标签</view>
        <view class="tag-list">
          <text class="detail-tag detail-tag-feature" wx:for="{{house.featureTags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="info-card" wx:if="{{house.infoList.length}}">
        <view class="card-title">房源信息</view>
        <view class="info-grid">
          <view class="info-item" wx:for="{{house.infoList}}" wx:key="label">
            <text class="info-label">{{item.label}}</text>
            <text class="info-value">{{item.value}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="content-bottom-space"></view>
  </view>

  <view class="fixed-contact-bar">
    <view class="contact-left">
      <view class="contact-avatar default-avatar">
        <view class="avatar-head"></view>
        <view class="avatar-body"></view>
      </view>
      <view class="contact-info">
        <text class="contact-name">{{house.contactName}}</text>
        <text class="contact-phone">{{house.contactPhone}}</text>
      </view>
    </view>
    <button class="call-btn" hover-class="none" bindtap="onCallTap">拨打电话</button>
  </view>
</view>
