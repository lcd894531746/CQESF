<view class="bind-page">
  <view class="bind-card">
    <view class="bind-title">绑定销售身份</view>
    <view class="bind-subtitle">请确认当前扫码微信属于本人，再完成绑定。</view>

    <view wx:if="{{loading}}" class="bind-loading">正在读取绑定信息...</view>

    <block wx:elif="{{errorMessage}}">
      <view class="bind-error">{{errorMessage}}</view>
      <button class="bind-secondary-btn" type="default" bindtap="onRetryTap">重新加载</button>
    </block>

    <block wx:else>
      <view class="bind-info-row">
        <text class="bind-info-label">员工姓名</text>
        <text class="bind-info-value">{{staffName || '-'}}</text>
      </view>
      <view class="bind-info-row">
        <text class="bind-info-label">员工角色</text>
        <text class="bind-info-value">{{staffRole || '-'}}</text>
      </view>
      <view class="bind-info-row">
        <text class="bind-info-label">二维码有效期</text>
        <text class="bind-info-value">{{expiresAt || '-'}}</text>
      </view>

      <view wx:if="{{successMessage}}" class="bind-success">{{successMessage}}</view>
      <view wx:if="{{errorMessage}}" class="bind-error">{{errorMessage}}</view>

      <button class="bind-primary-btn" type="primary" loading="{{confirming}}" disabled="{{confirming}}" bindtap="onConfirmTap">
        {{ confirming ? '绑定中...' : '确认绑定当前微信' }}
      </button>
    </block>
  </view>
</view>
