<view class="page">
  <view class="content fixed-panel">
    <view class="search-row">
      <view class="search-box">
        <view class="search-left">
          <image class="city-icon" src="/assets/icons/city-icon.png" mode="aspectFit" />
          <input
            class="search-input"
            type="text"
            placeholder="搜索标题、小区或描述"
            placeholder-class="search-placeholder"
            confirm-type="search"
            maxlength="50"
            cursor-spacing="20"
            value="{{keyword}}"
            bindinput="onKeywordInput"
            bindconfirm="onSearchConfirm"
          />
        </view>
        <view class="search-btn" bindtap="onSearchTap">搜索</view>
      </view>
    </view>
  </view>

  <scroll-view class="list-scroll" scroll-y lower-threshold="120" bindscrolltolower="onLoadMore">
    <view class="content list-content">
      <view class="waterfall" wx:if="{{canView}}">
        <view class="left-col">
          <block wx:for="{{feedLeft}}" wx:key="id">
            <view class="house-card" data-id="{{item.id}}" bindtap="onAssetTap">
              <image wx:if="{{item.hasImage}}" class="house-image" src="{{item.image}}" mode="aspectFill"></image>
              <view wx:else class="house-image empty-resource">
                <view class="empty-resource-icon">
                  <view class="empty-resource-roof"></view>
                  <view class="empty-resource-house">
                    <view class="empty-resource-door"></view>
                  </view>
                </view>
                <text class="empty-resource-text">暂无资源</text>
              </view>
              <view class="house-content">
                <text class="house-title">{{item.title}}</text>
                <view class="house-meta-line meta-tags">
                  <text class="meta-chip chip-area">{{item.areaText}}</text>
                  <text class="meta-chip" wx:if="{{item.layoutText}}">{{item.layoutText}}</text>
                  <text class="meta-chip" wx:if="{{item.orientationText}}">{{item.orientationText}}</text>
                </view>
                <view class="position-text">{{item.position}}</view>
                <view class="price-line">
                  <view class="price-item price-main">
                    <text class="price-label-main">总价</text>
                    <text class="price-start">{{item.totalPriceText}}</text>
                  </view>
                  <view class="price-item price-market-wrap">
                    <text class="price-label-sub">单价</text>
                    <text class="price-market">{{item.unitPriceText}}</text>
                  </view>
                </view>
                <view class="loan-line">
                  <text class="loan-item">首付 {{item.downPaymentText}}</text>
                  <text class="loan-item">月供 {{item.monthlyPaymentText}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
        <view class="right-col">
          <block wx:for="{{feedRight}}" wx:key="id">
            <view class="house-card" data-id="{{item.id}}" bindtap="onAssetTap">
              <image wx:if="{{item.hasImage}}" class="house-image" src="{{item.image}}" mode="aspectFill"></image>
              <view wx:else class="house-image empty-resource">
                <view class="empty-resource-icon">
                  <view class="empty-resource-roof"></view>
                  <view class="empty-resource-house">
                    <view class="empty-resource-door"></view>
                  </view>
                </view>
                <text class="empty-resource-text">暂无资源</text>
              </view>
              <view class="house-content">
                <text class="house-title">{{item.title}}</text>
                <view class="house-meta-line meta-tags">
                  <text class="meta-chip chip-area">{{item.areaText}}</text>
                  <text class="meta-chip" wx:if="{{item.layoutText}}">{{item.layoutText}}</text>
                  <text class="meta-chip" wx:if="{{item.orientationText}}">{{item.orientationText}}</text>
                </view>
                <view class="position-text">{{item.position}}</view>
                <view class="price-line">
                  <view class="price-item price-main">
                    <text class="price-label-main">总价</text>
                    <text class="price-start">{{item.totalPriceText}}</text>
                  </view>
                  <view class="price-item price-market-wrap">
                    <text class="price-label-sub">单价</text>
                    <text class="price-market">{{item.unitPriceText}}</text>
                  </view>
                </view>
                <view class="loan-line">
                  <text class="loan-item">首付 {{item.downPaymentText}}</text>
                  <text class="loan-item">月供 {{item.monthlyPaymentText}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{canView && !isLoading && feedLeft.length === 0 && feedRight.length === 0}}">暂无特殊资产</view>
      <view class="load-more-tip" wx:if="{{canView && !hasMore && (feedLeft.length > 0 || feedRight.length > 0)}}">没有更多了</view>
    </view>
  </scroll-view>
  <view class="phone-auth-mask" wx:if="{{showPhoneAuthDialog}}">
    <view class="phone-auth-dialog">
      <text class="phone-auth-title">需要获取手机号</text>
      <text class="phone-auth-desc">授权手机号前，请先阅读并同意以下协议。</text>
      <view class="phone-auth-legal">
        <text class="phone-auth-legal-text">点击“同意进入”即表示您已阅读并同意</text>
        <text class="phone-auth-legal-link" data-type="agreement" catchtap="onOpenLegalDocument">《用户协议》</text>
        <text class="phone-auth-legal-text">和</text>
        <text class="phone-auth-legal-link" data-type="privacy" catchtap="onOpenLegalDocument">《隐私政策》</text>
      </view>
      <view class="phone-auth-actions">
        <button class="phone-auth-btn phone-auth-cancel" bindtap="onRejectPhoneAuth">拒绝</button>
        <button class="phone-auth-btn phone-auth-confirm" open-type="getPhoneNumber" bindgetphonenumber="onBindStaffPhone">同意进入</button>
      </view>
    </view>
  </view>
</view>
