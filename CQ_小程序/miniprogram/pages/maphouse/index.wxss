.map-page {
  height: 100vh;
  background: #f5f6f8;
  display: flex;
  flex-direction: column;
}

.top-panel {
  background: #ffffff;
  padding: 8rpx 20rpx 14rpx;
}

.ershou-head {
  padding: 8rpx 4rpx 2rpx;
}

.ershou-title {
  color: #1f232d;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 46rpx;
}

.ershou-desc {
  margin-top: 6rpx;
  color: #8a919d;
  font-size: 22rpx;
  line-height: 32rpx;
}

.type-tabs {
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.type-tab {
  flex: 1;
  text-align: center;
  color: #1f232d;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 74rpx;
  position: relative;
}

.type-tab-active {
  color: #2f6de2;
}

.type-tab-active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 8rpx;
  width: 78rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #2f6de2;
}

.map-wrap {
  position: relative;
  flex: 1;
}

.house-map {
  width: 100%;
  height: 100%;
}

.loading-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(17, 24, 39, 0.72);
  color: #fff;
  font-size: 24rpx;
  line-height: 36rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  z-index: 5;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.18);
  white-space: nowrap;
}

.drawer-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.18);
  z-index: 6;
}

.ershou-drawer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 630rpx;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -12rpx 36rpx rgba(15, 23, 42, 0.12);
  padding: 14rpx 24rpx 0;
  box-sizing: border-box;
  z-index: 7;
  display: flex;
  flex-direction: column;
}

.drawer-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d6dae1;
  margin: 0 auto 18rpx;
}

.drawer-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  column-gap: 16rpx;
  padding-bottom: 18rpx;
}

.drawer-title-wrap {
  min-width: 0;
  flex: 1;
}

.drawer-title {
  color: #1f232d;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.drawer-subtitle {
  margin-top: 4rpx;
  color: #8a919d;
  font-size: 22rpx;
  line-height: 32rpx;
}

.drawer-close {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: #f2f4f7;
  color: #4b5563;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.drawer-list {
  flex: 1;
  min-height: 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

.drawer-card {
  display: flex;
  align-items: stretch;
  column-gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #eef1f4;
}

.drawer-card:first-child {
  border-top: 0;
}

.drawer-card-image {
  width: 180rpx;
  height: 136rpx;
  border-radius: 18rpx;
  background: #eef2f6;
  flex-shrink: 0;
}

.empty-resource {
  box-sizing: border-box;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.empty-resource-icon {
  position: relative;
  width: 58rpx;
  height: 52rpx;
}

.empty-resource-roof {
  position: absolute;
  left: 8rpx;
  top: 0;
  width: 38rpx;
  height: 38rpx;
  border-left: 7rpx solid #cbd5e1;
  border-top: 7rpx solid #cbd5e1;
  transform: rotate(45deg);
  border-radius: 4rpx;
}

.empty-resource-house {
  position: absolute;
  left: 8rpx;
  bottom: 0;
  width: 44rpx;
  height: 34rpx;
  border: 7rpx solid #cbd5e1;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.empty-resource-door {
  position: absolute;
  left: 14rpx;
  bottom: -7rpx;
  width: 12rpx;
  height: 18rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #cbd5e1;
}

.empty-resource-text {
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 700;
}

.drawer-card-body {
  flex: 1;
  min-width: 0;
}

.drawer-card-title {
  color: #1f232d;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.drawer-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.drawer-tag {
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 17rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 20rpx;
  font-weight: 600;
}

.drawer-tag-area {
  background: #e8f4ff;
  color: #175cd3;
}

.drawer-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  column-gap: 12rpx;
  margin-top: 16rpx;
}

.drawer-loan-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.drawer-loan-item {
  min-width: 0;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  white-space: nowrap;
}

.drawer-loan-monthly {
  color: #175cd3;
  font-size: 25rpx;
  font-weight: 900;
}

.drawer-auction-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.drawer-auction-item {
  min-width: 0;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  white-space: nowrap;
}

.drawer-auction-highlight {
  color: #175cd3;
}

.drawer-price-main {
  color: #f04438;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.drawer-price-sub {
  color: #1f232d;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}
