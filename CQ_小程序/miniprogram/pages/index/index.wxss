page {
  height: 100%;
  background: #f5f6f8;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.content {
  padding: 6rpx 20rpx 28rpx;
}

.fixed-panel {
  flex-shrink: 0;
  padding-bottom: 10rpx;
}

.notice-bar {
  margin-bottom: 16rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #fff8ef;
  border: 1rpx solid #f3dfb2;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.notice-icon {
  flex: 0 0 auto;
  margin-right: 16rpx;
  color: #c27a11;
  font-size: 22rpx;
  font-weight: 700;
}

.notice-marquee {
  flex: 1;
  height: 40rpx;
  overflow: hidden;
}

.notice-track {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  animation: notice-marquee-move 14s linear infinite;
}

.notice-text {
  flex: 0 0 auto;
  color: #7a5b2f;
  font-size: 24rpx;
  white-space: nowrap;
  line-height: 40rpx;
}

.notice-text-copy {
  padding-left: 80rpx;
}

@keyframes notice-marquee-move {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(calc(-50% - 40rpx));
  }
}

.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-content {
  padding-top: 0;
}

.city-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  margin-right: 4rpx;
}

.search-row {
  display: flex;
  align-items: center;
  column-gap: 12rpx;
  margin-bottom: 24rpx;
}

.search-box {
  min-height: 80rpx;
  border: 3rpx solid #1f7dff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx 0 18rpx;
  flex: 1;
  position: relative;
  z-index: 1;
}

.search-left {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 0 18rpx;
}

.search-icon {
  color: #9aa0ab;
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  color: #32353c;
  font-size: 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-weight: 500;
}

.search-placeholder {
  color: #9ea4af;
  font-size: 32rpx;
  font-weight: 500;
}

.search-btn {
  width: 110rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #1974ff;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.search-actions {
  display: flex;
  align-items: center;
  column-gap: 10rpx;
}

.map-btn {
  height: 64rpx;
  border-radius: 32rpx;
  padding: 0 20rpx;
  background: #eef4ff;
  color: #1e5fe0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.map-entry {
  width: 96rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.map-entry-icon {
  width: 48rpx;
  height: 48rpx;
}

.map-entry-text {
  margin-top: 2rpx;
  color: #4b5565;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 500;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  margin-bottom: 12rpx;
  column-gap: 10rpx;
}

.stats-card {
  height: 120rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.06);
  flex: 1;
  min-width: 0;
}

.stats-card-new {
  padding: 12rpx 76rpx 0 16rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #ffffff 58%, #ffedd5 100%);
}

.stats-card-running {
  padding: 12rpx 76rpx 0 16rpx;
  background: linear-gradient(135deg, #ecfdf5 0%, #ffffff 58%, #dcfce7 100%);
}

.stats-card-coming {
  padding: 12rpx 76rpx 0 16rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #ffffff 58%, #dbeafe 100%);
}

.stats-label {
  position: relative;
  display: block;
  color: #475467;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
  white-space: nowrap;
}

.stats-value-wrap {
  position: relative;
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}

.stats-value {
  color: #111827;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 700;
}

.stats-unit {
  margin-left: 4rpx;
  color: #475467;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 400;
}

.stats-content {
  position: relative;
  z-index: 2;
}

.stats-mark {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-mark::before {
  content: '';
  position: absolute;
  inset: -12rpx;
  border-radius: 50%;
  opacity: 0.35;
}

.stats-mark-new {
  background: #fb923c;
  color: #ffffff;
}

.stats-mark-new::before {
  background: #fed7aa;
}

.stats-mark-running {
  background: #22c55e;
}

.stats-mark-running::before {
  background: #bbf7d0;
}

.stats-mark-coming {
  background: #3b82f6;
}

.stats-mark-coming::before {
  background: #bfdbfe;
}

.stats-mark-text {
  position: relative;
  z-index: 1;
  font-size: 16rpx;
  line-height: 1;
  font-weight: 900;
}

.stats-gavel-head {
  position: absolute;
  left: 14rpx;
  top: 17rpx;
  width: 28rpx;
  height: 13rpx;
  border-radius: 5rpx;
  background: #ffffff;
  transform: rotate(-35deg);
}

.stats-gavel-handle {
  position: absolute;
  right: 15rpx;
  bottom: 13rpx;
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: #ffffff;
  transform: rotate(-35deg);
  transform-origin: center bottom;
}

.stats-clock-face {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  box-sizing: border-box;
}

.stats-clock-face::after {
  content: '';
  position: absolute;
  left: 26rpx;
  top: 26rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #ffffff;
}

.stats-clock-hand {
  position: absolute;
  left: 27rpx;
  top: 27rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform-origin: left center;
}

.stats-clock-hour {
  width: 13rpx;
  transform: rotate(-90deg);
}

.stats-clock-minute {
  width: 18rpx;
  transform: rotate(45deg);
}

.filter-row {
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid #eceff3;
  border-radius: 14rpx;
  padding: 8rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
}

.filter-row picker {
  width: 32.2%;
}

.filter-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 50rpx;
  border-radius: 999rpx;
  background: #f6f7fb;
  border: 1rpx solid transparent;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.filter-item-active {
  background: #edf4ff;
  border-color: #c7dbff;
}

.filter-item-active .filter-text,
.filter-item-active .filter-arrow {
  color: #2f6de2;
}

.filter-text {
  color: #667085;
  font-size: 26rpx;
  font-weight: 500;
  max-width: 78%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.filter-arrow {
  margin-left: 8rpx;
  color: #7b8497;
  font-size: 36rpx;
  line-height: 1;
}

.phone-auth-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(17, 24, 39, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.phone-auth-dialog {
  width: 100%;
  max-width: 620rpx;
  border-radius: 20rpx;
  background: #ffffff;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.phone-auth-title {
  color: #111827;
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 700;
}

.phone-auth-desc {
  margin-top: 16rpx;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 40rpx;
}

.phone-auth-legal {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 38rpx;
}

.phone-auth-legal-text {
  color: #6b7280;
}

.phone-auth-legal-link {
  color: #1974ff;
}

.phone-auth-actions {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  column-gap: 20rpx;
}

.phone-auth-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
}

.phone-auth-btn::after {
  border: none;
}

.phone-auth-cancel {
  background: #f3f4f6;
  color: #374151;
}

.phone-auth-confirm {
  background: #1974ff;
  color: #ffffff;
}

.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.left-col,
.right-col {
  flex: 1;
  min-width: 0;
}

.house-card {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  border: 1rpx solid #efeff2;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.house-image-wrap {
  position: relative;
  overflow: hidden;
  width: 100%;
  max-width: 100%;
  height: 258rpx;
}

.house-image {
  width: 100%;
  max-width: 100%;
  height: 258rpx;
  display: block;
}

.auction-mode-badge {
  position: absolute;
  left: 0;
  top: 0;
  width: 58rpx;
  height: 31rpx;
  z-index: 3;
}

.community-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0rpx;
  height: 44rpx;
  background: rgba(49, 49, 49, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.community-text {
  display: block;
  width: 100%;
  max-width: 100%;
  color: #fff;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.house-content {
  padding: 14rpx 14rpx 12rpx;
}

.house-title {
  color: #1f232d;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  min-height: 82rpx;
}

.house-meta-line {
  display: block;
  margin-top: 12rpx;
  color: #636b78;
  font-size: 21rpx;
  line-height: 30rpx;
}

.meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.meta-chip {
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 17rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 20rpx;
  font-weight: 600;
}

.chip-area {
  background: #e8f4ff;
  color: #175cd3;
}

.price-line {
  margin-top: 14rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  column-gap: 12rpx;
  flex-wrap: nowrap;
}

.price-item {
  display: flex;
  align-items: baseline;
  column-gap: 6rpx;
  min-width: 0;
  white-space: nowrap;
}

.price-main {
  flex: 1;
}

.price-market-wrap {
  flex-shrink: 0;
}

.price-label-main {
  color: #98a2b3;
  font-size: 20rpx;
  font-weight: 600;
}

.price-label-sub {
  color: #98a2b3;
  font-size: 18rpx;
  font-weight: 600;
}

.price-start {
  color: #f04438;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.price-market {
  color: #1f232d;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.status-line {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  column-gap: 10rpx;
  line-height: 24rpx;
}

.status-label {
  flex-shrink: 0;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 28rpx;
  height: 28rpx;
}

.status-upcoming {
  color: #b54708;
  background: #fffaeb;
}

.status-running {
  color: #175cd3;
  background: #eff8ff;
}

.status-finished {
  color: #344054;
  background: #f2f4f7;
}

.status-unknown {
  color: #6941c6;
  background: #f9f5ff;
}

.time-text {
  color: #8a919d;
  font-size: 20rpx;
  line-height: 24rpx;
  flex: 1;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.load-more-tip {
  text-align: center;
  color: #9aa0ab;
  font-size: 24rpx;
  padding: 14rpx 0 30rpx;
}

.wechat-id-panel {
  margin-top: 16rpx;
  padding: 20rpx 18rpx;
  background: #ffffff;
  border: 1rpx solid #eceff3;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.wechat-id-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  column-gap: 12rpx;
}

.wechat-id-title {
  color: #111827;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.wechat-id-subtitle {
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 30rpx;
}

.wechat-id-btn {
  margin-top: 14rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: #111827;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.wechat-id-btn::after {
  border: 0;
}

.wechat-id-result {
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}

.wechat-id-text {
  color: #111827;
  font-size: 22rpx;
  line-height: 32rpx;
  word-break: break-all;
}
