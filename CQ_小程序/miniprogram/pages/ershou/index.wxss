page {
  height: 100%;
  background: #f5f6f8;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.content {
  padding: 6rpx 20rpx 28rpx;
}

.fixed-panel {
  flex-shrink: 0;
  padding-bottom: 10rpx;
}

.openid-card {
  margin-bottom: 12rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6f3;
  display: flex;
  flex-direction: column;
  row-gap: 10rpx;
}

.openid-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  column-gap: 12rpx;
}

.openid-card-title {
  color: #111827;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.openid-card-copy {
  color: #1f7dff;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.openid-card-value {
  color: #4b5563;
  font-size: 22rpx;
  line-height: 32rpx;
  word-break: break-all;
}

.openid-card-sub {
  color: #6b7280;
  font-size: 20rpx;
  line-height: 30rpx;
  word-break: break-all;
}

.city-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  margin-right: 4rpx;
}

.phone-auth-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(17, 24, 39, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.phone-auth-dialog {
  width: 100%;
  max-width: 620rpx;
  border-radius: 20rpx;
  background: #ffffff;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.phone-auth-title {
  color: #111827;
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 700;
}

.phone-auth-desc {
  margin-top: 16rpx;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 40rpx;
}

.phone-auth-actions {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  column-gap: 20rpx;
}

.phone-auth-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
}

.phone-auth-btn::after {
  border: none;
}

.phone-auth-cancel {
  background: #f3f4f6;
  color: #374151;
}

.phone-auth-confirm {
  background: #1974ff;
  color: #ffffff;
}

.search-row {
  display: flex;
  align-items: center;
  column-gap: 12rpx;
  margin-bottom: 12rpx;
}

.search-box {
  min-height: 80rpx;
  border: 3rpx solid #1f7dff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx 0 18rpx;
  flex: 1;
}

.search-left {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 0 18rpx;
}

.search-input {
  flex: 1;
  color: #32353c;
  font-size: 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-weight: 500;
}

.search-placeholder {
  color: #9ea4af;
  font-size: 32rpx;
  font-weight: 500;
}

.search-btn {
  width: 110rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #1974ff;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.map-entry {
  width: 96rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.map-entry-icon {
  width: 48rpx;
  height: 48rpx;
}

.map-entry-text {
  margin-top: 2rpx;
  color: #4b5565;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 500;
}

.filter-panel {
  background: #ffffff;
  border: 1rpx solid #e6edf8;
  border-radius: 16rpx;
  padding: 6rpx 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(20, 40, 90, 0.04);
}

.notice-bar {
  margin-bottom: 16rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #fff8ef;
  border: 1rpx solid #f3dfb2;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.notice-icon {
  flex: 0 0 auto;
  margin-right: 16rpx;
  color: #c27a11;
  font-size: 22rpx;
  font-weight: 700;
}

.notice-marquee {
  flex: 1;
  height: 40rpx;
  overflow: hidden;
}

.notice-track {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  animation: notice-marquee-move 14s linear infinite;
}

.notice-text {
  flex: 0 0 auto;
  color: #7a5b2f;
  font-size: 24rpx;
  white-space: nowrap;
  line-height: 40rpx;
}

.notice-text-copy {
  padding-left: 80rpx;
}

@keyframes notice-marquee-move {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(calc(-50% - 40rpx));
  }
}

.filter-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.filter-panel-title {
  display: block;
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 30rpx;
}

.filter-panel-subtitle {
  display: none;
  margin-top: 0;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 28rpx;
}

.filter-grid {
  display: flex;
  flex-wrap: nowrap;
  gap: 4rpx;
}

.filter-picker {
  flex: none;
  width: calc((100% - 12rpx) / 4);
}

.filter-chip {
  height: 40rpx;
  padding: 0 6rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #e6edf8;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 2rpx;
}

.filter-label {
  color: #94a3b8;
  font-size: 14rpx;
  line-height: 16rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.filter-value-row {
  margin-top: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 2rpx;
  min-width: 0;
}

.filter-value {
  color: #334155;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 18rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-arrow {
  color: #cbd5e1;
  font-size: 10rpx;
  flex-shrink: 0;
}

.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-content {
  padding-top: 0;
}

.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.left-col,
.right-col {
  flex: 1;
}

.house-card {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  border: 1rpx solid #efeff2;
}

.house-image-wrap {
  position: relative;
}

.house-image {
  width: 100%;
  height: 258rpx;
}

.new-badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  z-index: 3;
  min-width: 72rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff3b30 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(255, 59, 48, 0.28);
}

.empty-resource {
  box-sizing: border-box;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.empty-resource-icon {
  position: relative;
  width: 76rpx;
  height: 68rpx;
}

.empty-resource-roof {
  position: absolute;
  left: 11rpx;
  top: 0;
  width: 50rpx;
  height: 50rpx;
  border-left: 8rpx solid #cbd5e1;
  border-top: 8rpx solid #cbd5e1;
  transform: rotate(45deg);
  border-radius: 4rpx;
}

.empty-resource-house {
  position: absolute;
  left: 10rpx;
  bottom: 0;
  width: 56rpx;
  height: 42rpx;
  border: 8rpx solid #cbd5e1;
  border-radius: 10rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.empty-resource-door {
  position: absolute;
  left: 18rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 22rpx;
  border-radius: 7rpx 7rpx 0 0;
  background: #cbd5e1;
}

.empty-resource-text {
  color: #94a3b8;
  font-size: 24rpx;
  font-weight: 700;
}

.house-content {
  padding: 14rpx 14rpx 12rpx;
}

.house-title {
  color: #1f232d;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  min-height: 78rpx;
}

.house-meta-line {
  display: block;
  margin-top: 12rpx;
  color: #636b78;
  font-size: 21rpx;
  line-height: 30rpx;
}

.meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.meta-chip {
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 17rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 20rpx;
  font-weight: 600;
}

.chip-area {
  background: #e8f4ff;
  color: #175cd3;
}

.position-text {
  margin-top: 10rpx;
  color: #8a919d;
  font-size: 20rpx;
  line-height: 28rpx;
}

.price-line {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: nowrap;
}

.price-item {
  flex: 1;
  display: flex;
  align-items: baseline;
  min-width: 0;
  white-space: nowrap;
}

.price-market-wrap {
  justify-content: flex-end;
  text-align: right;
}

.price-label-main {
  color: #98a2b3;
  font-size: 18rpx;
  font-weight: 600;
}

.price-label-sub {
  color: #98a2b3;
  font-size: 18rpx;
  font-weight: 600;
}

.price-start {
  color: #f97316;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.price-market {
  color: #1f232d;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.loan-line {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.loan-item {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  column-gap: 4rpx;
  color: #64748b;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 30rpx;
  white-space: nowrap;
}

.loan-item-right {
  justify-content: flex-end;
  text-align: right;
}

.loan-label {
  color: #64748b;
  font-size: 16rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.loan-value-wrap {
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
  column-gap: 0;
  flex-shrink: 1;
  min-width: 0;
}

.loan-item-right .loan-value-wrap {
  justify-content: flex-end;
}

.loan-value {
  color: #ef4444;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.loan-unit {
  color: #ef4444;
  font-size: 14rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}

.load-more-tip {
  text-align: center;
  color: #9aa0ab;
  font-size: 24rpx;
  padding: 14rpx 0 30rpx;
}

.list-bottom-safe {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.empty-list-tip {
  margin: 28rpx 0 12rpx;
  padding: 28rpx 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e6edf8;
  text-align: center;
  color: #64748b;
  font-size: 24rpx;
  line-height: 36rpx;
}
