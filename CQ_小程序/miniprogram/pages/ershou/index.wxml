<view class="page">
  <view class="content fixed-panel">
    <view class="openid-card" wx:if="{{showOpenidCard && wechatLoginResult.phoneNumber}}">
      <view class="openid-card-head">
        <text class="openid-card-title">手机号</text>
        <text class="openid-card-copy" bindtap="onCopyOpenidTap">复制</text>
      </view>
      <text class="openid-card-value">{{wechatLoginResult.phoneNumber}}</text>
      <text class="openid-card-sub" wx:if="{{wechatLoginStatusText}}">{{wechatLoginStatusText}}</text>
    </view>
    <view class="notice-bar" wx:if="{{introText}}">
      <view class="notice-icon">简介</view>
      <view class="notice-marquee">
        <view class="notice-track">
          <text class="notice-text">{{introText}}</text>
          <text class="notice-text notice-text-copy">{{introText}}</text>
        </view>
      </view>
    </view>
    
    <view class="search-row">
      <view class="search-box">
        <view class="search-left">
          <image class="city-icon" src="/assets/icons/city-icon.png" mode="aspectFit" />
          <input
            class="search-input"
            type="text"
            placeholder="搜索标题或小区"
            placeholder-class="search-placeholder"
            confirm-type="search"
            maxlength="50"
            cursor-spacing="20"
            value="{{keyword}}"
            bindinput="onKeywordInput"
            bindconfirm="onSearchConfirm"
          />
        </view>
        <view class="search-btn" bindtap="onSearchTap">搜索</view>
      </view>
      <view class="map-entry" bindtap="onMapEntryTap">
        <image class="map-entry-icon" src="/assets/icons/icon_ditu.png" mode="aspectFit" />
        <text class="map-entry-text">地图找房</text>
      </view>
    </view>

    <view class="filter-panel">
      <view class="filter-grid">
        <picker class="filter-picker" mode="selector" range="{{filterOptions.minPrice}}" value="{{filterIndex.minPrice}}" bindchange="onMinPriceFilterChange">
          <view class="filter-chip">
            <text class="filter-label">最低</text>
            <view class="filter-value-row">
              <text class="filter-value">{{filterOptions.minPrice[filterIndex.minPrice]}}</text>
              <text class="filter-arrow">v</text>
            </view>
          </view>
        </picker>
        <picker class="filter-picker" mode="selector" range="{{filterOptions.maxPrice}}" value="{{filterIndex.maxPrice}}" bindchange="onMaxPriceFilterChange">
          <view class="filter-chip">
            <text class="filter-label">最高</text>
            <view class="filter-value-row">
              <text class="filter-value">{{filterOptions.maxPrice[filterIndex.maxPrice]}}</text>
              <text class="filter-arrow">v</text>
            </view>
          </view>
        </picker>
        <picker class="filter-picker" mode="selector" range="{{filterOptions.area}}" value="{{filterIndex.area}}" bindchange="onAreaFilterChange">
          <view class="filter-chip">
            <text class="filter-label">区域</text>
            <view class="filter-value-row">
              <text class="filter-value">{{filterOptions.area[filterIndex.area]}}</text>
              <text class="filter-arrow">v</text>
            </view>
          </view>
        </picker>
        <picker class="filter-picker" mode="selector" range="{{filterOptions.layout}}" value="{{filterIndex.layout}}" bindchange="onLayoutFilterChange">
          <view class="filter-chip">
            <text class="filter-label">面积</text>
            <view class="filter-value-row">
              <text class="filter-value">{{filterOptions.layout[filterIndex.layout]}}</text>
              <text class="filter-arrow">v</text>
            </view>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <scroll-view class="list-scroll" scroll-y lower-threshold="160" bindscrolltolower="onLoadMore">
    <view class="content list-content">
      <view class="waterfall" wx:if="{{feedLeft.length > 0 || feedRight.length > 0}}">
        <view class="left-col">
          <block wx:for="{{feedLeft}}" wx:key="id">
            <view class="house-card" data-id="{{item.id}}" bindtap="onHouseTap">
              <view class="house-image-wrap">
                <image wx:if="{{item.hasImage}}" class="house-image" src="{{item.image}}" mode="aspectFill"></image>
                <view wx:else class="house-image empty-resource">
                  <view class="empty-resource-icon">
                    <view class="empty-resource-roof"></view>
                    <view class="empty-resource-house">
                      <view class="empty-resource-door"></view>
                    </view>
                  </view>
                  <text class="empty-resource-text">暂无图片</text>
                </view>
                <view wx:if="{{item.isNewToday}}" class="new-badge">上新</view>
              </view>
              <view class="house-content">
                <text class="house-title">{{item.title}}</text>
                <view class="house-meta-line meta-tags">
                  <text class="meta-chip chip-area">{{item.areaText}}</text>
                  <text class="meta-chip" wx:if="{{item.layoutText}}">{{item.layoutText}}</text>
                  <text class="meta-chip" wx:if="{{item.orientationText}}">{{item.orientationText}}</text>
                </view>
                <view class="position-text">{{item.position}}</view>
                <view class="price-line">
                  <view class="price-item price-main">
                    <text class="price-label-main">总价</text>
                    <text class="price-start">{{item.totalPriceText}}</text>
                  </view>
                  <view class="price-item price-market-wrap">
                    <text class="price-label-sub">单价</text>
                    <text class="price-market">{{item.unitPriceText}}</text>
                  </view>
                </view>
                <view class="loan-line">
                  <view class="loan-item">
                    <text class="loan-label">首付</text>
                    <view class="loan-value-wrap">
                      <text class="loan-value">{{item.downPaymentValueText}}</text>
                      <text class="loan-unit">{{item.downPaymentUnitText}}</text>
                    </view>
                  </view>
                  <view class="loan-item loan-item-right">
                    <text class="loan-label">月供</text>
                    <view class="loan-value-wrap">
                      <text class="loan-value">{{item.monthlyPaymentValueText}}</text>
                      <text class="loan-unit">{{item.monthlyPaymentUnitText}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </view>

        <view class="right-col">
          <block wx:for="{{feedRight}}" wx:key="id">
            <view class="house-card" data-id="{{item.id}}" bindtap="onHouseTap">
              <view class="house-image-wrap">
                <image wx:if="{{item.hasImage}}" class="house-image" src="{{item.image}}" mode="aspectFill"></image>
                <view wx:else class="house-image empty-resource">
                  <view class="empty-resource-icon">
                    <view class="empty-resource-roof"></view>
                    <view class="empty-resource-house">
                      <view class="empty-resource-door"></view>
                    </view>
                  </view>
                  <text class="empty-resource-text">暂无图片</text>
                </view>
                <view wx:if="{{item.isNewToday}}" class="new-badge">上新</view>
              </view>
              <view class="house-content">
                <text class="house-title">{{item.title}}</text>
                <view class="house-meta-line meta-tags">
                  <text class="meta-chip chip-area">{{item.areaText}}</text>
                  <text class="meta-chip" wx:if="{{item.layoutText}}">{{item.layoutText}}</text>
                  <text class="meta-chip" wx:if="{{item.orientationText}}">{{item.orientationText}}</text>
                </view>
                <view class="position-text">{{item.position}}</view>
                <view class="price-line">
                  <view class="price-item price-main">
                    <text class="price-label-main">总价</text>
                    <text class="price-start">{{item.totalPriceText}}</text>
                  </view>
                  <view class="price-item price-market-wrap">
                    <text class="price-label-sub">单价</text>
                    <text class="price-market">{{item.unitPriceText}}</text>
                  </view>
                </view>
                <view class="loan-line">
                  <view class="loan-item">
                    <text class="loan-label">首付</text>
                    <view class="loan-value-wrap">
                      <text class="loan-value">{{item.downPaymentValueText}}</text>
                      <text class="loan-unit">{{item.downPaymentUnitText}}</text>
                    </view>
                  </view>
                  <view class="loan-item loan-item-right">
                    <text class="loan-label">月供</text>
                    <view class="loan-value-wrap">
                      <text class="loan-value">{{item.monthlyPaymentValueText}}</text>
                      <text class="loan-unit">{{item.monthlyPaymentUnitText}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view class="empty-list-tip" wx:if="{{!isRefreshing && feedLeft.length === 0 && feedRight.length === 0}}">
        {{emptyResultText || '暂无房源'}}
      </view>

      <view class="load-more-tip" wx:if="{{isLoadingMore && (feedLeft.length > 0 || feedRight.length > 0)}}">加载中...</view>
      <view class="load-more-tip" wx:if="{{!hasMore && (feedLeft.length > 0 || feedRight.length > 0)}}">没有更多了</view>
      <view class="list-bottom-safe"></view>
    </view>
  </scroll-view>

  <view class="phone-auth-mask" wx:if="{{showPhoneAuthDialog}}">
    <view class="phone-auth-dialog">
      <text class="phone-auth-title">需要先获取手机号</text>
      <text class="phone-auth-desc">低首付房源需要销售授权后查看</text>
      <view class="phone-auth-actions">
        <button class="phone-auth-btn phone-auth-cancel" bindtap="onRejectPhoneAuth">取消</button>
        <button class="phone-auth-btn phone-auth-confirm" open-type="getPhoneNumber" bindgetphonenumber="onBindStaffPhone">允许</button>
      </view>
    </view>
  </view>
</view>
